# ── SERVER CONFIG ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_this_in_production

# ── TURSO DATABASE (SQLite in Cloud) ──────────────────────────────────────────
# URL format: libsql://your-db-name.turso.io
TURSO_DATABASE_URL=libsql://intelliexam-v3.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── OPENAI (Sophia IA Engine) ────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_key_here

# ── SUPABASE RAG (Contexto SEP) ──────────────────────────────────────────────
# Optional: Meora 60% la calidad pedagógica de Sophia
# Get these at: https://supabase.com (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── LOGGING ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
