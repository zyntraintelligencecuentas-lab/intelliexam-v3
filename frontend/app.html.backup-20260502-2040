<script>
// ═══════════════════════════════════════════════════════════
// INTELLIEXAM V3 - FUTURISTA 3D DASHBOARD
// JavaScript con todas las funcionalidades mejoradas
// ═══════════════════════════════════════════════════════════

const API_URL = 'http://localhost:3001/api';
let currentUser = null;
let currentView = 'dashboard';
let chartInstances = {};

// ═══ UTILITIES ═══
function getToken() {
  return localStorage.getItem('ie_token') || sessionStorage.getItem('ie_token');
}

function setToken(token) {
  localStorage.setItem('ie_token', token);
}

function clearToken() {
  localStorage.removeItem('ie_token');
  sessionStorage.removeItem('ie_token');
  localStorage.removeItem('ie_user');
  sessionStorage.removeItem('ie_user');
}

async function api(endpoint, options = {}) {
  const token = getToken();
  const headers = {
    'Content-Type': 'application/json',
    ...(token && { 'Authorization': `Bearer ${token}` }),
    ...(options.headers || {})
  };

  const response = await fetch(`${API_URL}${endpoint}`, {
    ...options,
    headers
  });

  if (!response.ok) {
    const error = await response.json().catch(() => ({ error: 'Error desconocido' }));
    throw new Error(error.error || 'Error en la solicitud');
  }

  return response.json();
}

function toast(message, type = 'info') {
  const toastEl = document.getElementById('toast');
  const iconEl = document.getElementById('toastIcon');
  const messageEl = document.getElementById('toastMessage');

  const icons = {
    success: '✅',
    error: '❌',
    warning: '⚠️',
    info: 'ℹ️'
  };

  iconEl.textContent = icons[type] || icons.info;
  messageEl.textContent = message;

  toastEl.className = `toast-${type}`;
  toastEl.classList.add('show');

  setTimeout(() => {
    toastEl.classList.remove('show');
  }, 4000);
}

// ═══ MARKDOWN PARSER ═══
function parseMarkdown(text) {
  if (!text) return '';
  // Escape HTML first
  let safe = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  // Bold **text**
  safe = safe.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  // Italic *text*
  safe = safe.replace(/\*(.+?)\*/g, '<em>$1</em>');
  // Inline code `code`
  safe = safe.replace(/`([^`]+)`/g, '<code style="background:rgba(6,182,212,0.15);padding:2px 6px;border-radius:4px;font-family:monospace;font-size:0.9em;">$1</code>');
  // Bullet lists
  safe = safe.replace(/^- (.+)$/gm, '<li style="margin-left:16px;margin-bottom:4px;">$1</li>');
  safe = safe.replace(/(<li[^>]*>.*<\/li>\n?)+/g, '<ul style="margin:8px 0;">$&</ul>');
  // Newlines
  safe = safe.replace(/\n/g, '<br>');
  return safe;
}

// ═══ NAVIGATION ═══
function showView(viewName) {
  currentView = viewName;
  document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
  const navBtn = event?.target?.closest?.('.nav-item');
  if (navBtn) navBtn.classList.add('active');

  const titles = {
    dashboard: 'Dashboard',
    students: 'Estudiantes',
    exams: 'Exámenes',
    reports: 'Reportes',
    ai: 'Ameyalli IA',
    scan: 'Escanear',
    settings: 'Configuración'
  };

  document.getElementById('pageTitle').textContent = titles[viewName] || viewName;

  const loaders = {
    dashboard: loadDashboard,
    students: loadStudents,
    exams: loadExams,
    reports: loadReports,
    ai: loadAI,
    scan: loadScan,
    settings: loadSettings
  };

  if (loaders[viewName]) {
    loaders[viewName]();
  }
}

function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('mobile-open');
}

function toggleUserMenu() {
  // Implementar menú de usuario
  toast('Menú de usuario (próximamente)', 'info');
}

function quickAction() {
  if (currentView === 'students') {
    openModal('importCSVModal');
  } else if (currentView === 'ai') {
    openModal('historyModal');
    loadChatSessions();
  } else {
    toast('Acción rápida no disponible en esta vista', 'info');
  }
}

// ═══ MODALS ═══
function openModal(modalId) {
  document.getElementById(modalId).classList.add('show');
}

function closeModal(modalId) {
  document.getElementById(modalId).classList.remove('show');
}

// ═══ USER ═══
async function loadUser() {
  try {
    const data = await api('/auth/me');
    currentUser = data.user;
    document.getElementById('userName').textContent = data.user.full_name;
    const initials = data.user.full_name.split(' ').map(n => n[0]).join('').substring(0, 2);
    document.getElementById('userAvatar').textContent = initials;
  } catch (err) {
    console.error('Error loading user:', err);
    throw err;
  }
}

async function logout() {
  try {
    await api('/auth/logout', { method: 'POST' });
  } catch (err) {
    console.error('Logout error:', err);
  } finally {
    clearToken();
    window.location.href = 'login.html';
  }
}

// ═══ DASHBOARD ═══
async function loadDashboard() {
  const contentArea = document.getElementById('contentArea');

  contentArea.innerHTML = `
    <div class="grid grid-4 mb-4">
      <div class="stat-card cyan-card">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;">
          <div>
            <div class="stat-label" style="color:var(--cyan);">Total Estudiantes</div>
            <div class="stat-value" id="totalStudents" style="background:linear-gradient(135deg,var(--cyan),white);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">0</div>
            <div class="stat-change positive">↑ conectado</div>
          </div>
          <div style="font-size:32px;opacity:0.5;">👥</div>
        </div>
      </div>
      <div class="stat-card green-card">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;">
          <div>
            <div class="stat-label" style="color:var(--green);">Promedio General</div>
            <div class="stat-value" id="avgScore" style="background:linear-gradient(135deg,var(--green),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">-</div>
            <div class="stat-change positive">↑ grupo activo</div>
          </div>
          <div style="font-size:32px;opacity:0.5;">📊</div>
        </div>
      </div>
      <div class="stat-card purple-card">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;">
          <div>
            <div class="stat-label" style="color:var(--purple);">Exámenes</div>
            <div class="stat-value" id="totalExams" style="background:linear-gradient(135deg,var(--purple),var(--blue));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">0</div>
            <div class="stat-change">Registrados</div>
          </div>
          <div style="font-size:32px;opacity:0.5;">📝</div>
        </div>
      </div>
      <div class="stat-card red-card">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;">
          <div>
            <div class="stat-label" style="color:var(--red);">Alertas</div>
            <div class="stat-value" id="alerts" style="background:linear-gradient(135deg,var(--red),var(--amber));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">0</div>
            <div class="stat-change negative">Requieren atención</div>
          </div>
          <div style="font-size:32px;opacity:0.5;">⚠️</div>
        </div>
      </div>
    </div>

    <div class="grid grid-2">
      <div class="card-3d" style="border-top: 2px solid var(--cyan);">
        <div class="card-header">
          <div class="card-title">Distribución de Calificaciones</div>
          <span class="card-badge badge-cyan">Actual</span>
        </div>
        <div style="position:relative; height:220px;">
          <canvas id="scoreDistChart"></canvas>
        </div>
      </div>

      <div class="card-3d" style="border-top: 2px solid var(--green);">
        <div class="card-header">
          <div class="card-title">Tendencia Mensual</div>
          <span class="card-badge badge-green">Mejorando</span>
        </div>
        <div style="position:relative; height:220px;">
          <canvas id="trendChart"></canvas>
        </div>
      </div>
    </div>

    <div class="card-3d mt-4" style="border-top: 2px solid var(--purple);">
      <div class="card-header">
        <div class="card-title">👥 Estudiantes Recientes</div>
        <button class="btn btn-secondary" onclick="loadStudents(); document.querySelectorAll('.nav-item').forEach(i=>i.classList.remove('active')); currentView='students';">Ver todos →</button>
      </div>
      <div id="recentStudents"></div>
    </div>
  `;

  try {
    const studentsData = await api('/students');
    const students = studentsData.students || [];

    document.getElementById('totalStudents').textContent = students.length;

    if (students.length > 0) {
      const avgScores = students.filter(s => s.avg).map(s => parseFloat(s.avg));
      const avg = avgScores.length ? (avgScores.reduce((a, b) => a + b, 0) / avgScores.length).toFixed(1) : 0;
      document.getElementById('avgScore').textContent = `${avg}%`;

      const alerts = students.filter(s => s.avg && parseFloat(s.avg) < 60).length;
      document.getElementById('alerts').textContent = alerts;

      renderScoreDistChart(avgScores);
      renderTrendChart();
      renderRecentStudents(students.slice(0, 5));
    }
  } catch (err) {
    console.error('Dashboard load error:', err);
    toast('Error cargando dashboard', 'error');
  }
}

function renderScoreDistChart(scores) {
  const ctx = document.getElementById('scoreDistChart');
  if (!ctx) return;

  if (chartInstances.scoreDistChart) {
    chartInstances.scoreDistChart.destroy();
  }

  const ranges = [
    { label: '90-100', count: scores.filter(s => s >= 90).length },
    { label: '80-89', count: scores.filter(s => s >= 80 && s < 90).length },
    { label: '70-79', count: scores.filter(s => s >= 70 && s < 80).length },
    { label: '60-69', count: scores.filter(s => s >= 60 && s < 70).length },
    { label: '<60', count: scores.filter(s => s < 60).length }
  ];

  chartInstances.scoreDistChart = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: ranges.map(r => r.label),
      datasets: [{
        data: ranges.map(r => r.count),
        backgroundColor: [
          '#10b981',
          '#06b6d4',
          '#f59e0b',
          '#fb923c',
          '#ef4444'
        ],
        borderWidth: 0,
        borderRadius: 4,
        spacing: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '65%',
      plugins: {
        legend: {
          position: 'right',
          labels: {
            color: '#cbd5e1',
            font: {
              family: 'Inter',
              size: 11
            },
            boxWidth: 12,
            padding: 12
          }
        }
      }
    }
  });
}

function renderTrendChart() {
  const ctx = document.getElementById('trendChart');
  if (!ctx) return;

  if (chartInstances.trendChart) {
    chartInstances.trendChart.destroy();
  }

  chartInstances.trendChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
      datasets: [{
        label: 'Promedio',
        data: [72, 74, 71, 76, 78, 80],
        borderColor: '#06b6d4',
        backgroundColor: 'rgba(6, 182, 212, 0.1)',
        borderWidth: 3,
        tension: 0.4,
        fill: true,
        pointRadius: 5,
        pointBackgroundColor: '#06b6d4',
        pointBorderColor: '#fff',
