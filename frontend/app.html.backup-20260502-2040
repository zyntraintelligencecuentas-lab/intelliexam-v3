async function sendMessage() {
  const input = document.getElementById('chatInput');
  const message = input.value.trim();

  if (!message) return;

  input.value = '';
  input.disabled = true;

  const messagesContainer = document.getElementById('chatMessages');

  // Agregar mensaje del usuario
  messagesContainer.innerHTML += `
    <div style="align-self: flex-end; max-width: 70%; background: rgba(6, 182, 212, 0.15); padding: 12px 16px; border-radius: 16px 16px 4px 16px; border: 1px solid rgba(6, 182, 212, 0.3);">
      <p style="color: var(--text); font-size: 14px; margin: 0;">${message}</p>
    </div>
  `;

  // Agregar indicador de escritura
  messagesContainer.innerHTML += `
    <div id="typingIndicator" style="align-self: flex-start; max-width: 70%; background: rgba(139, 92, 246, 0.1); padding: 12px 16px; border-radius: 16px 16px 16px 4px; border: 1px solid rgba(139, 92, 246, 0.2);">
      <p style="color: var(--text-muted); font-size: 14px; margin: 0;">Ameyalli está escribiendo...</p>
    </div>
  `;

  messagesContainer.scrollTop = messagesContainer.scrollHeight;

  try {
    const result = await api('/ai/chat', {
      method: 'POST',
      body: JSON.stringify({ message })
    });

    // Remover indicador
    document.getElementById('typingIndicator').remove();

    // Agregar respuesta de Ameyalli con markdown renderizado
    let responseHtml = `
      <div style="align-self: flex-start; max-width: 78%; background: linear-gradient(135deg,rgba(139,92,246,0.12),rgba(6,182,212,0.08)); padding: 16px 20px; border-radius: 16px 16px 16px 4px; border: 1px solid rgba(139,92,246,0.25); box-shadow: 0 4px 20px rgba(139,92,246,0.1);">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px;">
          <div style="width:28px;height:28px;background:linear-gradient(135deg,var(--purple),var(--cyan));border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;">🤖</div>
          <span style="font-weight: 700; color: var(--purple); font-size:13px;">Ameyalli</span>
          <span style="font-size: 10px; color: var(--text-muted); font-family: var(--mono); margin-left:auto;">${result.tokens_used || 0} tokens · RAG: ${result.rag_used ? '✅' : '⚡'}</span>
        </div>
        <div style="color: var(--text); font-size: 14px; line-height: 1.7;">${parseMarkdown(result.content)}</div>
    `;

    // Detectar si la respuesta parece ser una planeación para ofrecer descarga
    if (result.content.toLowerCase().includes('planeación') || result.content.toLowerCase().includes('didáctica')) {
      responseHtml += `
        <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(139,92,246,0.2);">
          <button class="btn btn-secondary" style="font-size: 12px; padding: 8px 14px; width: 100%; justify-content: center;" 
                  onclick="generatePlaneacionPDF('Educación', '${currentUser?.grade || 'Grado'}', 'Personalizada')">
            <span>📄</span> Descargar esta Planeación en PDF
          </button>
        </div>
      `;
    }

    responseHtml += `</div>`;
    messagesContainer.innerHTML += responseHtml;

    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  } catch (err) {
    document.getElementById('typingIndicator').remove();
    toast(`Error: ${err.message}`, 'error');
  } finally {
    input.disabled = false;
    input.focus();
  }
}

