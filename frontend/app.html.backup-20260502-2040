<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>IntelliExam · Dashboard Futurista</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
<style>
/* ═══════════════════════════════════════════════════════════
   INTELLIEXAM V3 FUTURISTA · 3D GLASSMORPHISM DASHBOARD
   Diseño: Futurista 3D con efectos holográficos
   Stack: HTML + Tailwind-inspired + 3D CSS
   UX: ui-ux-pro-max patterns
   ═══════════════════════════════════════════════════════════ */

:root {
  /* Colores Base */
  --bg: #020817;
  --bg-light: #0f172a;

  /* Glassmorphism */
  --glass-1: rgba(15, 23, 42, 0.7);
  --glass-2: rgba(30, 41, 59, 0.5);
  --glass-border: rgba(148, 163, 184, 0.1);

  /* Acentos Futuristas */
  --cyan: #06b6d4;
  --cyan-glow: rgba(6, 182, 212, 0.3);
  --purple: #8b5cf6;
  --purple-glow: rgba(139, 92, 246, 0.3);
  --blue: #3b82f6;
  --green: #10b981;
  --amber: #f59e0b;
  --red: #ef4444;

  /* Texto */
  --text: #f8fafc;
  --text-dim: #cbd5e1;
  --text-muted: #64748b;

  /* Fuentes */
  --font: 'Inter', -apple-system, system-ui, sans-serif;
  --mono: 'JetBrains Mono', 'Courier New', monospace;

  /* 3D & Animation */
  --perspective: 1200px;
  --rotate-angle: 2deg;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);

  /* Z-index */
  --z-bg: 1;
  --z-content: 10;
  --z-nav: 20;
  --z-modal: 50;
  --z-toast: 100;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  height: 100%;
  overflow: hidden;
}

body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ═══ BACKGROUND 3D ═══ */
#bg-canvas {
  position: fixed;
  inset: 0;
  z-index: var(--z-bg);
  background:
    radial-gradient(ellipse 80% 60% at 10% 10%, rgba(6, 182, 212, 0.12) 0%, transparent 60%),
    radial-gradient(ellipse 70% 50% at 90% 90%, rgba(139, 92, 246, 0.12) 0%, transparent 60%),
    radial-gradient(ellipse 50% 40% at 50% 50%, rgba(59, 130, 246, 0.06) 0%, transparent 70%),
    linear-gradient(180deg, #020817 0%, #050d1f 50%, #0a0f1e 100%);
  pointer-events: none;
}

/* Holographic Grid */
.holo-grid {
  position: fixed;
  inset: 0;
  z-index: var(--z-bg);
  background-image:
    linear-gradient(rgba(6, 182, 212, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(6, 182, 212, 0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  perspective: var(--perspective);
  transform-style: preserve-3d;
  animation: gridFloat 20s ease-in-out infinite;
  pointer-events: none;
}

@keyframes gridFloat {
  0%, 100% { transform: rotateX(45deg) translateZ(0px); }
  50% { transform: rotateX(48deg) translateZ(-20px); }
}

/* Floating Orbs 3D */
.orb-3d {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.4;
  z-index: var(--z-bg);
  pointer-events: none;
  animation: float3d 15s ease-in-out infinite;
}

.orb-1 {
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, var(--cyan-glow), transparent 70%);
  top: -100px;
  left: -100px;
}

.orb-2 {
  width: 350px;
  height: 350px;
  background: radial-gradient(circle, var(--purple-glow), transparent 70%);
  bottom: -100px;
  right: -100px;
  animation-delay: -7s;
}

.orb-3 {
  width: 250px;
  height: 250px;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.2), transparent 70%);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation-delay: -3s;
}

@keyframes float3d {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(20px, -30px) scale(1.1); }
  66% { transform: translate(-20px, 20px) scale(0.95); }
}

/* ═══ LAYOUT 3D ═══ */
.app-container {
  position: relative;
  z-index: var(--z-content);
  display: grid;
  grid-template-columns: 280px 1fr;
  height: 100vh;
  perspective: var(--perspective);
  transform-style: preserve-3d;
  gap: 24px;
  padding: 20px;
}

/* ═══ SIDEBAR 3D ═══ */
.sidebar {
  background: var(--glass-1);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateZ(30px);
  transition: var(--transition);
  box-shadow:
    0 20px 60px rgba(0, 0, 0, 0.5),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.sidebar:hover {
  transform: translateZ(35px) translateY(-2px);
  box-shadow:
    0 25px 70px rgba(0, 0, 0, 0.6),
    0 0 40px var(--cyan-glow),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

/* Scrollbar Futurista */
::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--cyan), var(--purple));
  border-radius: 10px;
  box-shadow: 0 0 10px var(--cyan-glow);
}

/* Logo Section */
.logo-section {
  padding: 28px 24px;
  border-bottom: 1px solid var(--glass-border);
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.05), rgba(139, 92, 246, 0.05));
}

.logo-container {
  display: flex;
  align-items: center;
  gap: 14px;
}

.logo-icon {
  width: 48px;
  height: 48px;
  background: linear-gradient(135deg, var(--cyan), var(--purple));
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 800;
  color: white;
  box-shadow:
    0 8px 24px var(--cyan-glow),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
  transform: translateZ(5px);
  transition: var(--transition);
}

.logo-icon:hover {
  transform: translateZ(10px) scale(1.05);
  box-shadow:
    0 12px 32px var(--cyan-glow),
    0 0 40px var(--purple-glow);
}

.logo-text {
  flex: 1;
}

.logo-title {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.5px;
  background: linear-gradient(135deg, var(--cyan), white);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.logo-subtitle {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--text-dim);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-top: 2px;
}

/* AI Status - Ameyalli */
.ai-status {
  margin: 16px 20px;
  padding: 12px 16px;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(6, 182, 212, 0.1));
  border: 1px solid rgba(16, 185, 129, 0.2);
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--green);
  transform: translateZ(3px);
  transition: var(--transition);
}

.ai-status:hover {
  transform: translateZ(8px);
  box-shadow: 0 4px 20px rgba(16, 185, 129, 0.3);
}

.pulse-dot {
  width: 8px;
  height: 8px;
  background: var(--green);
  border-radius: 50%;
  box-shadow: 0 0 12px var(--green);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

/* Navigation */
.nav-container {
  flex: 1;
  padding: 8px 16px;
  overflow-y: auto;
}

.nav-section {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text-muted);
  padding: 0 12px;
  margin: 20px 0 8px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  margin: 4px 0;
  border-radius: 12px;
  cursor: pointer;
  transition: var(--transition);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-dim);
  background: none;
  border: none;
  width: 100%;
  text-align: left;
  position: relative;
  overflow: hidden;
}

.nav-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, var(--cyan), transparent);
  transition: width 0.3s ease;
  opacity: 0;
}

.nav-item:hover {
  background: rgba(6, 182, 212, 0.1);
  color: var(--cyan);
  transform: translateX(4px);
}

.nav-item:hover::before {
  width: 4px;
  opacity: 1;
}

.nav-item.active {
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(139, 92, 246, 0.15));
  color: var(--cyan);
  box-shadow:
    0 4px 12px rgba(6, 182, 212, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.nav-item.active::before {
  width: 4px;
  opacity: 1;
  background: linear-gradient(180deg, var(--cyan), var(--purple));
  box-shadow: 0 0 10px var(--cyan);
}

.nav-icon {
  font-size: 18px;
  flex-shrink: 0;
}

/* User Section */
.user-section {
  padding: 16px 20px;
  border-top: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  gap: 12px;
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.05), rgba(139, 92, 246, 0.05));
  cursor: pointer;
  transition: var(--transition);
}

.user-section:hover {
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.1), rgba(139, 92, 246, 0.1));
}

.user-avatar {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--purple), var(--cyan));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 16px;
  color: white;
  box-shadow: 0 4px 12px var(--purple-glow);
}

.user-info {
  flex: 1;
  overflow: hidden;
}

.user-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-role {
  font-size: 11px;
  color: var(--text-muted);
  font-family: var(--mono);
}

/* ═══ MAIN CONTENT 3D ═══ */
.main-content {
  background: var(--glass-1);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transform: translateZ(20px);
  transition: var(--transition);
  box-shadow:
    0 20px 60px rgba(0, 0, 0, 0.5),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.main-content:hover {
  transform: translateZ(25px) translateY(-1px);
}

/* Top Bar */
.top-bar {
  padding: 20px 28px;
  border-bottom: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.03), rgba(139, 92, 246, 0.03));
}

.page-title {
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.5px;
  background: linear-gradient(135deg, white, var(--cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.search-bar {
  flex: 1;
  max-width: 400px;
  margin: 0 24px;
  position: relative;
}

.search-input {
  width: 100%;
  padding: 10px 16px 10px 42px;
  background: rgba(15, 23, 42, 0.5);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  color: var(--text);
  font-size: 14px;
  font-family: var(--font);
  transition: var(--transition);
}

.search-input:focus {
  outline: none;
  border-color: var(--cyan);
  box-shadow: 0 0 20px rgba(6, 182, 212, 0.2);
  background: rgba(15, 23, 42, 0.7);
}

.search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  font-size: 16px;
  pointer-events: none;
}

.actions {
  display: flex;
  gap: 12px;
}

.btn {
  padding: 10px 20px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 600;
  font-family: var(--font);
  cursor: pointer;
  transition: var(--transition);
  border: none;
  display: flex;
  align-items: center;
  gap: 8px;
  transform: translateZ(2px);
}

.btn-primary {
  background: linear-gradient(135deg, var(--cyan), var(--purple));
  color: white;
  box-shadow: 0 4px 12px var(--cyan-glow);
}

.btn-primary:hover {
  transform: translateZ(8px) translateY(-2px);
  box-shadow: 0 8px 24px var(--cyan-glow);
}

.btn-secondary {
  background: rgba(148, 163, 184, 0.1);
  color: var(--text-dim);
  border: 1px solid var(--glass-border);
}

.btn-secondary:hover {
  background: rgba(148, 163, 184, 0.2);
  transform: translateZ(6px);
}

/* Content Area */
.content-area {
  flex: 1;
  overflow-y: auto;
  padding: 24px 28px;
}

/* Cards 3D */
.card-3d {
  background: var(--glass-2);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  padding: 24px;
  margin-bottom: 20px;
  transform: translateZ(5px);
  transition: var(--transition);
  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.03);
}

.card-3d:hover {
  transform: translateZ(12px) translateY(-4px);
  box-shadow:
    0 16px 40px rgba(0, 0, 0, 0.4),
    0 0 30px rgba(6, 182, 212, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.card-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
}

.card-badge {
  padding: 4px 12px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 600;
  font-family: var(--mono);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.badge-cyan {
  background: rgba(6, 182, 212, 0.15);
  color: var(--cyan);
  border: 1px solid rgba(6, 182, 212, 0.3);
}

.badge-green {
  background: rgba(16, 185, 129, 0.15);
  color: var(--green);
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.badge-amber {
  background: rgba(245, 158, 11, 0.15);
  color: var(--amber);
  border: 1px solid rgba(245, 158, 11, 0.3);
}

.badge-red {
  background: rgba(239, 68, 68, 0.15);
  color: var(--red);
  border: 1px solid rgba(239, 68, 68, 0.3);
}

/* Grid Layout */
.grid {
  display: grid;
  gap: 20px;
}

.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

/* Stats Cards */
.stat-card {
  position: relative;
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  padding: 20px;
  transform: translateZ(3px);
  transition: var(--transition);
  overflow: hidden;
}
.stat-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.08), rgba(139, 92, 246, 0.08));
  pointer-events: none;
}
.stat-card.cyan-card { border-top: 3px solid var(--cyan); box-shadow: 0 0 30px rgba(6,182,212,0.1), inset 0 0 20px rgba(6,182,212,0.03); }
.stat-card.green-card { border-top: 3px solid var(--green); box-shadow: 0 0 30px rgba(16,185,129,0.1), inset 0 0 20px rgba(16,185,129,0.03); }
.stat-card.purple-card { border-top: 3px solid var(--purple); box-shadow: 0 0 30px rgba(139,92,246,0.1), inset 0 0 20px rgba(139,92,246,0.03); }
.stat-card.red-card { border-top: 3px solid var(--red); box-shadow: 0 0 30px rgba(239,68,68,0.1), inset 0 0 20px rgba(239,68,68,0.03); }

.stat-card:hover {
  transform: translateZ(10px) translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.4), 0 0 40px rgba(6,182,212,0.15);
}

.stat-label {
  font-size: 12px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 8px;
  font-family: var(--mono);
}

.stat-value {
  font-size: 32px;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 4px;
}

.stat-change {
  font-size: 13px;
  font-family: var(--mono);
  display: flex;
  align-items: center;
  gap: 4px;
}

.stat-change.positive { color: var(--green); }
.stat-change.negative { color: var(--red); }

/* Modal Futurista */
.modal {
  position: fixed;
  inset: 0;
  z-index: var(--z-modal);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  background: rgba(2, 8, 23, 0.8);
  animation: fadeIn 0.3s ease;
}

.modal.show {
  display: flex;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: var(--glass-1);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  padding: 32px;
  max-width: 600px;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  transform: scale(0.9) translateZ(0);
  animation: modalSlideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  box-shadow:
    0 20px 60px rgba(0, 0, 0, 0.6),
    0 0 40px var(--cyan-glow);
}

@keyframes modalSlideIn {
  to {
    transform: scale(1) translateZ(20px);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.modal-title {
  font-size: 22px;
  font-weight: 800;
  color: var(--text);
}

.modal-close {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: none;
  background: rgba(148, 163, 184, 0.1);
  color: var(--text-dim);
  cursor: pointer;
  transition: var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
}

.modal-close:hover {
  background: rgba(239, 68, 68, 0.2);
  color: var(--red);
}

/* Form Elements */
.form-group {
  margin-bottom: 20px;
}

.form-label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-dim);
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.form-input,
.form-textarea,
.form-select {
  width: 100%;
  padding: 12px 16px;
  background: rgba(15, 23, 42, 0.5);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  color: var(--text);
  font-size: 14px;
  font-family: var(--font);
  transition: var(--transition);
}

.form-textarea {
  min-height: 120px;
  resize: vertical;
  font-family: var(--mono);
}

.form-input:focus,
.form-textarea:focus,
.form-select:focus {
  outline: none;
  border-color: var(--cyan);
  box-shadow: 0 0 20px rgba(6, 182, 212, 0.2);
  background: rgba(15, 23, 42, 0.7);
}

/* Table Futurista */
.table-3d {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 8px;
}

.table-3d thead th {
  padding: 12px 16px;
  text-align: left;
  font-size: 11px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-family: var(--mono);
  background: transparent;
}

.table-3d tbody tr {
  background: rgba(15, 23, 42, 0.3);
  border-radius: 12px;
  transition: var(--transition);
  cursor: pointer;
}

.table-3d tbody tr:hover {
  background: rgba(6, 182, 212, 0.1);
  transform: translateX(4px);
  box-shadow: 0 4px 12px rgba(6, 182, 212, 0.15);
}

.table-3d tbody td {
  padding: 16px;
