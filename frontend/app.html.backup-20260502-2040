      <p style="color: var(--text-muted); text-align: center; padding: 60px;">Funcionalidad de escaneo próximamente</p>
    </div>
  `;
}

// ═══ SETTINGS ═══
async function loadSettings() {
  const contentArea = document.getElementById('contentArea');
  contentArea.innerHTML = `
    <div class="grid grid-2" style="max-width:900px;">
      <div class="card-3d" style="border-top:2px solid var(--cyan);">
        <div class="card-header">
          <div class="card-title">👤 Perfil Docente</div>
          <span class="card-badge badge-cyan">Editable</span>
        </div>
        <div class="form-group">
          <label class="form-label">Nombre Completo</label>
          <input type="text" class="form-input" id="settingName" value="${currentUser?.full_name || ''}" placeholder="Tu nombre completo">
        </div>
        <div class="form-group">
          <label class="form-label">Correo Electrónico</label>
          <input type="email" class="form-input" id="settingEmail" value="${currentUser?.email || ''}" disabled style="opacity:0.6;cursor:not-allowed;">
          <small style="color:var(--text-muted);font-size:11px;margin-top:4px;display:block;">El correo no se puede cambiar</small>
        </div>
        <div class="form-group">
          <label class="form-label">Escuela / Institución</label>
          <input type="text" class="form-input" id="settingSchool" value="${currentUser?.school || ''}" placeholder="Nombre de tu escuela">
        </div>
        <div class="form-group">
          <label class="form-label">Grado que impartes</label>
          <input type="text" class="form-input" id="settingGrade" value="${currentUser?.grade || ''}" placeholder="Ej: 3° y 4° Primaria">
        </div>
        <div class="form-group">
          <label class="form-label">Grupo</label>
          <input type="text" class="form-input" id="settingGroup" value="${currentUser?.group_name || ''}" placeholder="Ej: A, B, Mixto">
        </div>
        <div style="display:flex;gap:12px;margin-top:8px;">
          <button class="btn btn-primary" style="flex:1;" onclick="saveProfile()">
            <span>💾</span>
            <span>Guardar Cambios</span>
          </button>
          <button class="btn btn-secondary" onclick="logout()">
            <span>🚪</span>
            <span>Salir</span>
          </button>
        </div>
      </div>

      <div class="card-3d" style="border-top:2px solid var(--purple);">
        <div class="card-header">
          <div class="card-title">🔑 Seguridad & Sistema</div>
        </div>
        <div style="background:rgba(6,182,212,0.08);border:1px solid rgba(6,182,212,0.2);border-radius:12px;padding:16px;margin-bottom:16px;">
          <div style="font-size:13px;font-weight:600;color:var(--cyan);margin-bottom:8px;">Estado del Sistema</div>
          <div style="display:grid;gap:8px;font-size:13px;color:var(--text-dim);font-family:var(--mono);">
            <div>✅ Backend conectado · Puerto 3001</div>
            <div>✅ Base de datos Turso · Activa</div>
            <div>✅ Ameyalli IA · Claude 3.7 Sonnet</div>
            <div id="ragStatusLine">⏳ RAG SEP · Verificando...</div>
          </div>
        </div>
        <div style="background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.2);border-radius:12px;padding:16px;">
          <div style="font-size:13px;font-weight:600;color:var(--purple);margin-bottom:8px;">Mi Plan</div>
          <div style="font-size:24px;font-weight:800;color:var(--text);">${currentUser?.plan || 'free'}</div>
          <div style="font-size:12px;color:var(--text-muted);margin-top:4px;">IntelliExam v3 · Sistema de Gestión Docente</div>
        </div>
      </div>
    </div>
  `;

  // Check RAG / AI status
  try {
    const ragEl = document.getElementById('ragStatusLine');
    if (!ragEl) return;
    const resp = await api('/ai/sessions');
    ragEl.textContent = resp ? '✅ Ameyalli IA · Conectada y operativa' : '⚠️ IA · Sin respuesta';
  } catch(e) {
    const ragEl = document.getElementById('ragStatusLine');
    if (ragEl) ragEl.textContent = '❌ IA · Error de conexión';
  }
}

async function saveProfile() {
  const full_name = document.getElementById('settingName').value.trim();
  const school = document.getElementById('settingSchool').value.trim();
  const grade = document.getElementById('settingGrade').value.trim();
  const group_name = document.getElementById('settingGroup').value.trim();

  if (!full_name) {
    toast('El nombre es obligatorio', 'warning');
    return;
  }

  try {
    await api('/auth/profile', {
      method: 'PUT',
      body: JSON.stringify({ full_name, school, grade, group_name })
    });

    // Update current user in memory
    currentUser = { ...currentUser, full_name, school, grade, group_name };
    document.getElementById('userName').textContent = full_name;
    const initials = full_name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
    document.getElementById('userAvatar').textContent = initials;

    toast('✅ Perfil actualizado correctamente', 'success');
  } catch (err) {
    toast(`Error: ${err.message}`, 'error');
  }
}

// ═══ INIT ═══
async function init() {
  const token = getToken();
  if (!token) {
    window.location.href = 'login.html';
    return;
  }

  try {
    await loadUser();
    await loadDashboard();

    // Mostrar menú toggle en mobile
    if (window.innerWidth <= 1024) {
      document.getElementById('menuToggle').style.display = 'flex';
    }
  } catch (err) {
    console.error('Init error:', err);
    toast('Error de autenticación', 'error');
    setTimeout(() => {
      window.location.href = 'login.html';
    }, 2000);
  } finally {
    setTimeout(() => {
      document.getElementById('loading-screen').classList.add('hide');
      setTimeout(() => {
        document.getElementById('loading-screen').remove();
      }, 500);
    }, 1000);
  }
}

// Responsive
window.addEventListener('resize', () => {
  const menuToggle = document.getElementById('menuToggle');
  if (window.innerWidth <= 1024) {
    menuToggle.style.display = 'flex';
  } else {
    menuToggle.style.display = 'none';
    document.getElementById('sidebar').classList.remove('mobile-open');
  }
});

// Close modal on outside click
window.addEventListener('click', (e) => {
  if (e.target.classList.contains('modal')) {
    e.target.classList.remove('show');
  }
});

// Start app
init();
</script>
</body>
</html>
